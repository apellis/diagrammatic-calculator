diagcalc-workspace/1
context klrw type=A1 ring=QQ red=2i@0 quotient=cyclotomic

# The simple module $L = P/\mathrm{rad}\,P$ at $i@1$, where $e(i@1) A e(i@1) = k[x]/(x^2)$; its result shows the presentation $P/xP$.
module L := {"head":"i@1"}  # id=md1

# The first two terms of its projective resolution; the kernel at position $-1$ is still to be covered.
complex R := {"differentials":[{"from":-1,"matrix":[["x_1 e(i@1)"]]}],"resolves":{"module":"L"},"terms":[{"at":-1,"summands":[{"object":"i@1","shift":2}]},{"at":0,"summands":[{"object":"i@1","shift":0}]}]}  # id=cx2
