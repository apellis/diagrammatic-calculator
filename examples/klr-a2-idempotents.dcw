diagcalc-workspace/1
context klr type=A2 nu=2i+j ring=QQ Lambda=2i+j

note """Idempotents of e(iji) in the cyclotomic quotient $R^\Lambda(2\alpha_i+\alpha_j)$ of type $A_2$, $\Lambda = 2\Lambda_i + \Lambda_j$.

Every idempotent in the span of $e(iji)$ and $\psi_1\psi_2\psi_1 e(iji)$, then the two that split $e(iji)$."""  # id=nt1
def e := c1 e(iji) + c2 psi_1 psi_2 psi_1 e(iji)  # id=df2
watch e e - e  # id=wt3
solve e e - e = 0 for c1, c2  # id=sv4
def a := psi_1 psi_2 psi_1 e(iji)  # id=df5
def b := e(iji) - a  # id=df6
check idempotent(a)  # id=ck7
check idempotent(b)  # id=ck8
check orthogonal(a, b)  # id=ck9
check equal(b, -psi_2 psi_1 psi_2 e(iji))  # id=ck10
check primitive(a)  # id=ck11
check primitive(b)  # id=ck12
watch psi_1 psi_2 psi_1 e(iji) - psi_2 psi_1 psi_2 e(iji)  # id=wt13
