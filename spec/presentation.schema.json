{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/apellis/diagrammatic-calculator/spec/presentation.schema.json",
  "title": "Presentation file (.pres.toml), as the JSON value of its TOML",
  "description": "A presentation of a strict monoidal supercategory: colours, generators (possibly schemas over colour variables), parameters, relation schemas and representations. Terms inside are in the text term format (spec/text-term.md).",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "format",
    "name",
    "colours",
    "generators"
  ],
  "properties": {
    "format": {
      "const": "diagcalc-presentation/1"
    },
    "name": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]*$"
    },
    "title": {
      "type": "string"
    },
    "colours": {
      "description": "Fixed colours, or \"cartan\": one colour per simple root of the context's Cartan datum.",
      "oneOf": [
        {
          "const": "cartan"
        },
        {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/colour"
          }
        }
      ]
    },
    "objects": {
      "description": "\"weight\": a term without an idempotent ranges over all sequences of the context's weight; \"explicit\": only objects written in the term.",
      "enum": [
        "weight",
        "explicit"
      ],
      "default": "explicit"
    },
    "generator_order": {
      "description": "The order of the generators (TOML tables are unordered).",
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "parameters": {
      "type": "object",
      "additionalProperties": {
        "$ref": "#/$defs/parameter"
      }
    },
    "generators": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "$ref": "#/$defs/generator"
      }
    },
    "bubbles": {
      "description": "Bubble families of a 2-category: written NAME_{c,m} in terms, a closed diagram in the region it sits in. For m with index(m) >= 0 the bubble is its word; below that it is a fake bubble, determined by the infinite Grassmannian relation with its partner family.",
      "type": "object",
      "additionalProperties": {
        "$ref": "#/$defs/bubbleFamily"
      }
    },
    "relations": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/relation"
      }
    },
    "representations": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/representation"
      }
    },
    "lean": {
      "description": "The Lean counterpart, for exporting rewrite chains: where the diagrams live and which lemma proves each relation. Templates write {a} for a colour variable, {a!=b} for a proof that two colours differ and {simp} for a side condition simp proves.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "encoding",
        "module",
        "namespace",
        "generators"
      ],
      "properties": {
        "encoding": {
          "enum": [
            "kl3-dg"
          ]
        },
        "module": {
          "description": "Modules to import, separated by spaces.",
          "type": "string"
        },
        "namespace": {
          "type": "string"
        },
        "open": {
          "type": "string"
        },
        "generators": {
          "description": "Each generator's Lean shape.",
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        },
        "relations": {
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "lemma"
            ],
            "properties": {
              "lemma": {
                "description": "The lemma, applied at the weight ν.",
                "type": "string"
              },
              "facts": {
                "description": "Cartan data the lemma depends on: 'dot {a} {b}', 'dot≠0 {a} {b}' or 'dij {a} {b}'.",
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "layering": {
                "enum": [
                  "canonical",
                  "left-first"
                ]
              }
            }
          }
        }
      }
    }
  },
  "$defs": {
    "colour": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name"
      ],
      "properties": {
        "name": {
          "type": "string"
        },
        "parity": {
          "enum": [
            "even",
            "odd"
          ],
          "default": "even"
        },
        "oriented": {
          "type": "boolean",
          "default": false
        }
      }
    },
    "intExpr": {
      "description": "An integer, or an expression in the colour variables: (a,b) the symmetric form, a_ab a Cartan entry, d_a a symmetrizer, p(a) a parity, h(a) the pairing of h_a with the weight of the region right of the generator (in a 2-category), with + - and juxtaposed products.",
      "oneOf": [
        {
          "type": "integer"
        },
        {
          "type": "string"
        }
      ]
    },
    "pattern": {
      "description": "Space-separated colours or colour variables, a trailing * for a downward strand.",
      "type": "string"
    },
    "generator": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source",
        "target",
        "degree"
      ],
      "properties": {
        "colours": {
          "description": "Space-separated colour variables of the schema.",
          "type": "string",
          "default": ""
        },
        "source": {
          "$ref": "#/$defs/pattern"
        },
        "target": {
          "$ref": "#/$defs/pattern"
        },
        "degree": {
          "$ref": "#/$defs/intExpr"
        },
        "parity": {
          "$ref": "#/$defs/intExpr",
          "default": 0
        },
        "draw": {
          "enum": [
            "dot",
            "crossing",
            "cup",
            "cap",
            "box"
          ],
          "default": "box"
        },
        "aliases": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "written": {
          "description": "The name the generator is written with in terms, when several generators share it (for example a dot on an upward and on a downward strand). The source decides which one is meant; a generator with an empty source takes its colour explicitly, as cup_{1,a*}.",
          "type": "string"
        }
      }
    },
    "parameter": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "vars"
      ],
      "properties": {
        "vars": {
          "type": "array",
          "items": {
            "enum": [
              "u",
              "v",
              "w"
            ]
          }
        },
        "default": {
          "description": "A built-in default (klq2) or a polynomial in vars.",
          "type": "string"
        },
        "hypotheses": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "derived": {
          "description": "qbar(P): (P(u,v) - P(w,v)) / (u - w).",
          "type": "string",
          "pattern": "^qbar\\([A-Za-z]+\\)$"
        }
      }
    },
    "relation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "lhs",
        "rhs"
      ],
      "properties": {
        "name": {
          "type": "string"
        },
        "colours": {
          "type": "string",
          "default": ""
        },
        "when": {
          "description": "A side condition: a = b, a != b, and, or, not, comparisons of integer expressions.",
          "type": "string"
        },
        "ints": {
          "description": "Integer variables of the schema, each with an inclusive range whose ends are integer expressions (they may use h(a), the weight of the relation's rightmost region). An empty range gives no instance.",
          "type": "object",
          "additionalProperties": {
            "type": "string",
            "pattern": "^.+\\.\\..+$"
          }
        },
        "lhs": {
          "type": "string"
        },
        "rhs": {
          "type": "string"
        }
      }
    },
    "representation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "kind",
        "roles",
        "certificate"
      ],
      "properties": {
        "name": {
          "type": "string"
        },
        "kind": {
          "enum": [
            "klr-polynomial",
            "nil-coxeter",
            "odd-nil-coxeter"
          ]
        },
        "roles": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "dot",
            "crossing"
          ],
          "properties": {
            "dot": {
              "type": "string"
            },
            "crossing": {
              "type": "string"
            }
          }
        },
        "certificate": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "status"
          ],
          "properties": {
            "status": {
              "enum": [
                "lean",
                "literature",
                "assumed",
                "unknown"
              ]
            },
            "reference": {
              "type": "string"
            },
            "hypotheses": {
              "type": "string"
            }
          }
        }
      }
    },
    "bubbleFamily": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "word",
        "index",
        "partner"
      ],
      "properties": {
        "colours": {
          "type": "string",
          "default": ""
        },
        "word": {
          "description": "The bubble for label m, a term with no source or target in which the integer variable m may appear.",
          "type": "string"
        },
        "index": {
          "description": "Half the degree divided by d_a, as an expression in m and h(a); the bubble is real where it is >= 0. The fake bubbles of index k are the coefficients of the inverse of the partner family's generating series.",
          "type": "string"
        },
        "partner": {
          "description": "The family that enters the infinite Grassmannian relation with this one.",
          "type": "string"
        }
      }
    }
  }
}
