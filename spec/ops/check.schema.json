{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/apellis/diagrammatic-calculator/spec/ops/check.schema.json",
  "title": "check: a named yes-or-no property with a witness",
  "description": "Phase 1 checks: equal(a, b), zero(a), idempotent(e), orthogonal(e, f), homogeneous(a). central and primitive refuse with a precondition error until phase 2.",
  "$defs": {
    "request": {
      "allOf": [{ "$ref": "common.schema.json#/$defs/termRequest" }],
      "required": ["name", "terms"],
      "properties": {
        "name": { "enum": ["equal", "zero", "idempotent", "orthogonal", "homogeneous", "central", "primitive"] },
        "terms": { "type": "array", "items": { "type": "string" }, "minItems": 1, "maxItems": 2 }
      }
    },
    "response": {
      "oneOf": [{ "$ref": "common.schema.json#/$defs/verdict" }, { "$ref": "common.schema.json#/$defs/error" }]
    }
  }
}
