{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/apellis/diagrammatic-calculator/spec/ops/common.schema.json",
  "title": "Shared parts of operation messages",
  "$defs": {
    "context": {
      "description": "A context line without the word 'context', e.g. \"klr type=A2 nu=2i+j ring=QQ\" (spec/workspace.md).",
      "type": "string"
    },
    "termRequest": {
      "type": "object",
      "required": [
        "context"
      ],
      "properties": {
        "context": {
          "$ref": "#/$defs/context"
        },
        "presentation": {
          "description": "The text of a presentation file, when the context names one that is not shipped.",
          "type": "string"
        },
        "strategy": {
          "description": "The name of a representation the presentation declares; the first one by default.",
          "type": "string"
        }
      }
    },
    "provenance": {
      "type": "object",
      "required": [
        "strategy",
        "method",
        "certificate"
      ],
      "properties": {
        "strategy": {
          "enum": [
            "basis normal form",
            "faithful representation",
            "confluent rewriting",
            "finite-dimensional linear algebra",
            "bounded search"
          ]
        },
        "method": {
          "type": "string"
        },
        "notes": {
          "description": "What the result says about how it was computed, such as the quotient and the degrees computed (finite-dimensional linear algebra). Formulas are TeX between $ signs, as in a note cell.",
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "certificate": {
          "type": "object",
          "required": [
            "status",
            "reference",
            "hypotheses"
          ],
          "properties": {
            "status": {
              "enum": [
                "lean",
                "literature",
                "conditional",
                "assumed",
                "unknown"
              ]
            },
            "reference": {
              "type": "string"
            },
            "hypotheses": {
              "type": "string"
            }
          }
        }
      }
    },
    "error": {
      "type": "object",
      "required": [
        "status",
        "kind",
        "message"
      ],
      "properties": {
        "status": {
          "const": "error"
        },
        "kind": {
          "enum": [
            "syntax",
            "invalid",
            "precondition",
            "limit"
          ]
        },
        "message": {
          "type": "string"
        }
      }
    },
    "verdict": {
      "type": "object",
      "required": [
        "status",
        "holds",
        "witness",
        "certified_by",
        "provenance"
      ],
      "properties": {
        "status": {
          "const": "ok"
        },
        "holds": {
          "type": "boolean"
        },
        "witness": {
          "description": "When the check fails: the normal form of what should vanish.",
          "type": [
            "string",
            "null"
          ]
        },
        "certified_by": {
          "description": "What this verdict rests on: 'computation' when the computation alone proves it (every step is a relation of the presentation, so a vanishing normal form proves the term zero whatever the certificate says); 'certificate' when it also rests on the representation's certificate, for example that distinct normal forms differ. A verdict that rests on a conditional certificate is conditional; one certified by computation is not.",
          "enum": [
            "computation",
            "certificate"
          ]
        },
        "provenance": {
          "$ref": "#/$defs/provenance"
        }
      }
    },
    "location": {
      "description": "Where in a term: the summand (numbered from 1 in printed order) and optionally a rectangle of its canonical layering (layers numbered from 1 at the bottom, strands from 1 at the left; both ends included).",
      "type": "object",
      "properties": {
        "term": {
          "type": "string"
        },
        "summand": {
          "type": "integer",
          "minimum": 1
        },
        "rectangle": {
          "type": "object",
          "required": [
            "layers",
            "strands"
          ],
          "properties": {
            "layers": {
              "type": "array",
              "items": {
                "type": "integer",
                "minimum": 1
              },
              "minItems": 2,
              "maxItems": 2
            },
            "strands": {
              "type": "array",
              "items": {
                "type": "integer",
                "minimum": 1
              },
              "minItems": 2,
              "maxItems": 2
            }
          }
        },
        "relation": {
          "description": "Only this relation.",
          "type": "string"
        }
      }
    },
    "match": {
      "type": "object",
      "required": [
        "relation",
        "direction",
        "binding",
        "pattern",
        "replacement",
        "occurrence",
        "moves",
        "sign",
        "rectangle"
      ],
      "properties": {
        "relation": {
          "type": "string"
        },
        "direction": {
          "enum": [
            "left to right",
            "right to left"
          ]
        },
        "binding": {
          "description": "The colours bound to the relation's colour variables.",
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        },
        "pattern": {
          "description": "The side of the relation instance that is matched.",
          "type": "string"
        },
        "replacement": {
          "description": "What the pattern equals.",
          "type": "string"
        },
        "occurrence": {
          "description": "The matched layers of the summand, in the pattern's order.",
          "type": "array",
          "items": {
            "type": "integer"
          }
        },
        "moves": {
          "description": "Interchange moves bringing the pattern together, each the lower of two exchanged layers.",
          "type": "array",
          "items": {
            "type": "integer"
          }
        },
        "sign": {
          "description": "The Koszul sign of the moves.",
          "enum": [
            1,
            -1
          ]
        },
        "rectangle": {
          "description": "The rectangle the pattern fills after the moves.",
          "type": "object",
          "required": [
            "layers",
            "strands"
          ],
          "properties": {
            "layers": {
              "type": "array",
              "items": {
                "type": "integer"
              }
            },
            "strands": {
              "type": "array",
              "items": {
                "type": "integer"
              }
            }
          }
        },
        "index": {
          "type": "integer",
          "minimum": 0
        },
        "preview": {
          "description": "The summand after applying this match.",
          "type": "string"
        }
      }
    },
    "step": {
      "allOf": [
        {
          "$ref": "#/$defs/match"
        }
      ],
      "type": "object",
      "required": [
        "word",
        "results"
      ],
      "properties": {
        "word": {
          "description": "The rewritten summand with its coefficient.",
          "type": "string"
        },
        "results": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "term",
              "from"
            ],
            "properties": {
              "term": {
                "type": "string"
              },
              "from": {
                "description": "Provenance: for each layer of the result, the layer of the rewritten summand it came from, or null if the relation created it.",
                "type": "array",
                "items": {
                  "type": [
                    "integer",
                    "null"
                  ]
                }
              }
            }
          }
        }
      }
    },
    "chain": {
      "type": "object",
      "required": [
        "start",
        "term",
        "steps",
        "provenance"
      ],
      "properties": {
        "start": {
          "type": "string"
        },
        "term": {
          "description": "The term after the last step.",
          "type": "string"
        },
        "steps": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/step"
          }
        },
        "provenance": {
          "$ref": "#/$defs/provenanceMap"
        }
      }
    },
    "summand": {
      "description": "One summand of a term for display. The term's text is the summands' texts joined with their signs; the drawing shows the word in its canonical layering, and 'negative' and 'coefficient' are the sign and absolute coefficient that go with the drawing (they can differ in sign from 'text' when odd generators are written in another order).",
      "type": "object",
      "required": [
        "text",
        "word",
        "degree",
        "source",
        "target",
        "negative",
        "coefficient",
        "svg"
      ],
      "properties": {
        "text": {
          "description": "The summand alone in canonical text form, with its coefficient.",
          "type": "string"
        },
        "word": {
          "description": "The word without its coefficient; distinct summands of a term have distinct words.",
          "type": "string"
        },
        "degree": {
          "type": "integer"
        },
        "source": {
          "description": "The bottom object, as inside e(...).",
          "type": "string"
        },
        "target": {
          "description": "The top object.",
          "type": "string"
        },
        "negative": {
          "type": "boolean"
        },
        "coefficient": {
          "description": "The absolute value of the coefficient, null when it is 1.",
          "type": [
            "string",
            "null"
          ]
        },
        "svg": {
          "description": "The word drawn as a standalone SVG.",
          "type": "string"
        }
      }
    },
    "provenanceMap": {
      "description": "Where each generator occurrence of a result came from (docs/conventions.md, Provenance): for each summand of the result, in printed order, its word and, for each of its layers (canonical, from the bottom), the generator and the occurrences [summand, layer] (1-based) of the starting term it descends from. An empty list: the layer was created. An occurrence listed under several summands was split; one listed nowhere was deleted.",
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "word",
          "layers"
        ],
        "properties": {
          "word": {
            "type": "string"
          },
          "layers": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "generator",
                "from"
              ],
              "properties": {
                "generator": {
                  "type": "string"
                },
                "from": {
                  "type": "array",
                  "items": {
                    "type": "array",
                    "items": {
                      "type": "integer",
                      "minimum": 1
                    },
                    "minItems": 2,
                    "maxItems": 2
                  }
                }
              }
            }
          }
        }
      }
    },
    "complexPosition": {
      "description": "A position: an integer, or a list of integers for a multicomplex.",
      "oneOf": [
        {
          "type": "integer"
        },
        {
          "type": "array",
          "items": {
            "type": "integer"
          },
          "minItems": 1
        }
      ]
    },
    "complexEntry": {
      "description": "A term, or null (or \"0\") for zero.",
      "type": [
        "string",
        "null"
      ]
    },
    "complexMatrix": {
      "description": "Rows index the summands of the target, columns those of the source.",
      "type": "array",
      "items": {
        "type": "array",
        "items": {
          "$ref": "common.schema.json#/$defs/complexEntry"
        }
      }
    },
    "complexSummand": {
      "type": "object",
      "required": [
        "object"
      ],
      "properties": {
        "object": {
          "description": "An indecomposable object, e.g. a loading \"i@0 R@0.5\" or e(...).",
          "type": "string"
        },
        "loading": {
          "type": "string"
        },
        "shift": {
          "description": "X⟨s⟩ has its generator in degree s.",
          "type": "integer"
        }
      }
    },
    "complexSummands": {
      "type": "array",
      "items": {
        "$ref": "common.schema.json#/$defs/complexSummand"
      }
    },
    "complex": {
      "type": "object",
      "required": [
        "terms"
      ],
      "properties": {
        "dimension": {
          "type": "integer",
          "minimum": 1
        },
        "indexing": {
          "enum": [
            "cohomological",
            "homological"
          ],
          "description": "cohomological (default): d raises the position by 1; homological: d lowers it by 1."
        },
        "squares": {
          "enum": [
            "commute",
            "anticommute"
          ]
        },
        "odd_signs": {
          "enum": [
            "koszul",
            "ignore"
          ]
        },
        "terms": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "at",
              "summands"
            ],
            "properties": {
              "at": {
                "$ref": "common.schema.json#/$defs/complexPosition"
              },
              "summands": {
                "$ref": "common.schema.json#/$defs/complexSummands"
              }
            }
          }
        },
        "differentials": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "from",
              "matrix"
            ],
            "properties": {
              "from": {
                "$ref": "common.schema.json#/$defs/complexPosition"
              },
              "axis": {
                "type": "integer",
                "minimum": 0
              },
              "matrix": {
                "$ref": "common.schema.json#/$defs/complexMatrix"
              }
            }
          }
        },
        "resolves": {
          "description": "Makes the complex a resolution of a module: C₀ (at position 0, the last term) maps onto the module by the augmentation, a matrix from C₀ to the generators (a row for each generator, a column for each summand of C₀; it may be left out when C₀ is the sum of the generators, in order, and is then the identity).",
          "type": "object",
          "required": [
            "module"
          ],
          "properties": {
            "module": {
              "$ref": "common.schema.json#/$defs/module"
            },
            "augmentation": {
              "$ref": "common.schema.json#/$defs/complexMatrix"
            }
          }
        }
      }
    },
    "complexMap": {
      "description": "Components of a map, one matrix per source position.",
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "at",
          "matrix"
        ],
        "properties": {
          "at": {
            "$ref": "common.schema.json#/$defs/complexPosition"
          },
          "matrix": {
            "$ref": "common.schema.json#/$defs/complexMatrix"
          }
        }
      }
    },
    "complexFailure": {
      "type": "object",
      "required": [
        "condition",
        "location",
        "detail"
      ],
      "properties": {
        "condition": {
          "type": "string"
        },
        "location": {
          "type": "string"
        },
        "detail": {
          "type": "string"
        },
        "maps": {
          "description": "The maps the failure involves, so a front end can highlight them: {\"map\": \"differential\", \"from\": p, \"axis\": a}, {\"map\": \"component\", \"at\": p}, {\"map\": \"augmentation\"}, or {\"map\": \"presentation\"}, with \"row\" and \"col\" when one entry is meant.",
          "type": "array",
          "items": {
            "type": "object",
            "required": ["map"],
            "properties": {
              "map": {
                "enum": ["differential", "component", "augmentation", "presentation"]
              },
              "row": {"type": "integer", "minimum": 0},
              "col": {"type": "integer", "minimum": 0}
            }
          }
        }
      }
    },
    "degreeWindow": {
      "description": "The degrees searched; truncated when Hom spaces are unbounded above and higher degrees were not searched.",
      "type": [
        "object",
        "null"
      ],
      "required": [
        "from",
        "to",
        "truncated"
      ],
      "properties": {
        "from": {
          "type": "integer"
        },
        "to": {
          "type": "integer"
        },
        "truncated": {
          "type": "boolean"
        }
      }
    },
    "complexVerdict": {
      "type": "object",
      "required": [
        "status",
        "holds",
        "failures",
        "failure_count",
        "certified_by",
        "provenance"
      ],
      "properties": {
        "status": {
          "const": "ok"
        },
        "holds": {
          "type": "boolean"
        },
        "failures": {
          "type": "array",
          "items": {
            "$ref": "common.schema.json#/$defs/complexFailure"
          }
        },
        "failure_count": {
          "type": "integer"
        },
        "certified_by": {
          "enum": [
            "computation",
            "certificate"
          ]
        },
        "provenance": {
          "$ref": "common.schema.json#/$defs/provenance"
        },
        "conventions": {
          "type": "object"
        }
      }
    },
    "module": {
      "description": "A module over the algebra. Either a presentation M = coker(φ: Q₁ → Q₀), by generators (the summands of Q₀), relations (the summands of Q₁), and the matrix of φ: a row for each generator, a column for each relation, entry (i, j) the component of relation j at generator i (without relations, M = Q₀ is projective); or {\"head\": P}, the module P/rad P, for P an object, a summand {object, shift}, or a list of summands, which is read as the presentation module.head finds.",
      "type": "object",
      "properties": {
        "generators": {
          "$ref": "common.schema.json#/$defs/complexSummands"
        },
        "relations": {
          "$ref": "common.schema.json#/$defs/complexSummands"
        },
        "matrix": {
          "$ref": "common.schema.json#/$defs/complexMatrix"
        },
        "head": {
          "description": "The projective P of P/rad P: an object, a summand, or a list of summands.",
          "oneOf": [
            {
              "type": "string"
            },
            {
              "$ref": "common.schema.json#/$defs/complexSummand"
            },
            {
              "$ref": "common.schema.json#/$defs/complexSummands"
            }
          ]
        }
      },
      "oneOf": [
        {
          "required": [
            "generators"
          ],
          "not": {
            "required": [
              "head"
            ]
          }
        },
        {
          "required": [
            "head"
          ],
          "not": {
            "anyOf": [
              {
                "required": [
                  "generators"
                ]
              },
              {
                "required": [
                  "relations"
                ]
              },
              {
                "required": [
                  "matrix"
                ]
              }
            ]
          }
        }
      ]
    },
    "moduleDimensions": {
      "description": "Graded dimensions at the test objects T: dim Hom(T⟨d⟩, M) for each degree d, as a Laurent polynomial in q and as [degree, dimension] pairs.",
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "test",
          "dimensions",
          "powers"
        ],
        "properties": {
          "test": {
            "type": "string"
          },
          "dimensions": {
            "type": "string"
          },
          "powers": {
            "type": "array",
            "items": {
              "type": "array",
              "items": {
                "type": "integer"
              },
              "minItems": 2,
              "maxItems": 2
            }
          }
        }
      }
    }
  }
}
