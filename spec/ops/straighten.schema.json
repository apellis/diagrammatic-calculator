{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/apellis/diagrammatic-calculator/spec/ops/straighten.schema.json",
  "title": "straighten: rewrite to the basis normal form, recording the chain",
  "$defs": {
    "request": {
      "allOf": [
        {
          "$ref": "common.schema.json#/$defs/termRequest"
        }
      ],
      "required": [
        "term"
      ],
      "properties": {
        "term": {
          "type": "string"
        },
        "max_steps": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "response": {
      "oneOf": [
        {
          "type": "object",
          "required": [
            "status",
            "start",
            "term",
            "steps",
            "agrees",
            "basis",
            "provenance"
          ],
          "properties": {
            "status": {
              "const": "ok"
            },
            "start": {
              "type": "string"
            },
            "term": {
              "type": "string"
            },
            "steps": {
              "type": "array",
              "items": {
                "$ref": "common.schema.json#/$defs/step"
              }
            },
            "agrees": {
              "description": "Whether the result equals the representation's normal form.",
              "type": "boolean"
            },
            "basis": {
              "description": "The representation whose basis is the target.",
              "type": "string"
            },
            "provenance": {
              "$ref": "common.schema.json#/$defs/provenanceMap"
            }
          }
        },
        {
          "$ref": "common.schema.json#/$defs/error"
        }
      ]
    }
  }
}
