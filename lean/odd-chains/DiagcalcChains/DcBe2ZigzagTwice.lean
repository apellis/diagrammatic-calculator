/-- Two zigzags around an odd dot. Found by the calculator: a rewrite chain of 2 steps. -/
theorem dc_be2_zigzag_twice {I : Type u} {X : Type v} [AddCommGroup X] (D : Datum I X)
    {k : Type w} [CommRing k] (Sc : Scalars D k) (μ : X)
    (ci : I)
    (hp_ci : D.parity ci = 1) :
    cl D Sc μ [up ci] [up ci] [([up ci], .cup ci, []), ([], .cap ci, [up ci]), ([], .dot ci, []), ([up ci], .cup ci, []), ([], .cap ci, [up ci])] =
      cl D Sc μ [up ci] [up ci] [([], .dot ci, [])] := by
  -- zigzag-e (left to right), a = i
  have E0 : ∀ ν : X, cl D Sc ν [up ci] [up ci] [([up ci], .cup ci, []), ([], .cap ci, [up ci])] =
      cl D Sc ν [up ci] [up ci] [] := fun ν => by
    exact cl_zigE Sc ci ν
  -- step 1: zigzag-e at layer 1, strand 1
  have KL0 : cl D Sc μ [up ci] [up ci] [([up ci], .cup ci, []), ([], .cap ci, [up ci]), ([], .dot ci, []), ([up ci], .cup ci, []), ([], .cap ci, [up ci])] =
      cl D Sc μ [up ci] [up ci] [([], .dot ci, []), ([up ci], .cup ci, []), ([], .cap ci, [up ci])] := by
    rw [cl_stepL_at _ 0 [] [] (E0 _) (by (try cnorm); cchain) (by (try cnorm); cchain) (by cnorm)]
    try simp only [map_add, map_sub, map_neg, map_zsmul, map_zero]
    repeat rw [ctxL_cl _ (by (try cnorm); cchain) (by (try cnorm); cchain)]
    try cnorm
    try cpar
    try simp only [hp_ci]
    try csign
    try abel
  -- step 2: zigzag-e at layer 2, strand 1
  have KL1 : cl D Sc μ [up ci] [up ci] [([], .dot ci, []), ([up ci], .cup ci, []), ([], .cap ci, [up ci])] =
      cl D Sc μ [up ci] [up ci] [([], .dot ci, [])] := by
    rw [cl_stepL_at _ 1 [] [] (E0 _) (by (try cnorm); cchain) (by (try cnorm); cchain) (by cnorm)]
    try simp only [map_add, map_sub, map_neg, map_zsmul, map_zero]
    repeat rw [ctxL_cl _ (by (try cnorm); cchain) (by (try cnorm); cchain)]
    try cnorm
    try cpar
    try simp only [hp_ci]
    try csign
    try abel
  have L : cl D Sc μ [up ci] [up ci] [([up ci], .cup ci, []), ([], .cap ci, [up ci]), ([], .dot ci, []), ([up ci], .cup ci, []), ([], .cap ci, [up ci])] = cl D Sc μ [up ci] [up ci] [([], .dot ci, [])] := by
    rw [KL0, KL1]
    try abel
  have R : cl D Sc μ [up ci] [up ci] [([], .dot ci, [])] = cl D Sc μ [up ci] [up ci] [([], .dot ci, [])] := by
    try abel
  exact L.trans R.symm

