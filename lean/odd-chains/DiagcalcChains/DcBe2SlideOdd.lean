/-- Two dots slide down through an odd crossing. Found by the calculator: a rewrite chain of 2 steps. -/
theorem dc_be2_slide_odd {I : Type u} {X : Type v} [AddCommGroup X] (D : Datum I X)
    {k : Type w} [CommRing k] (Sc : Scalars D k) (μ : X)
    (ci : I)
    (hp_ci : D.parity ci = 1) :
    cl D Sc μ [up ci, up ci] [up ci, up ci] [([], .cross ci ci, []), ([], .dot ci, [up ci]), ([], .dot ci, [up ci])] =
      cl D Sc μ [up ci, up ci] [up ci, up ci] [([], .dot ci, [up ci])] - cl D Sc μ [up ci, up ci] [up ci, up ci] [([up ci], .dot ci, [])] + cl D Sc μ [up ci, up ci] [up ci, up ci] [([up ci], .dot ci, []), ([up ci], .dot ci, []), ([], .cross ci ci, [])] := by
  -- dot-slide-right-same (left to right), a = i
  have E0 : ∀ ν : X, cl D Sc ν [up ci, up ci] [up ci, up ci] [([], .cross ci ci, []), ([], .dot ci, [up ci])] =
      cl D Sc ν [up ci, up ci] [up ci, up ci] [] - cl D Sc ν [up ci, up ci] [up ci, up ci] [([up ci], .dot ci, []), ([], .cross ci ci, [])] := fun ν => by
    refine (cl_slideREq Sc ci ν).trans ?_
    try cnorm
    try cpar
    try simp only [hp_ci]
    try csign
    try abel
  -- step 1: dot-slide-right-same at layer 1, strands 1–2
  have K0 : cl D Sc μ [up ci, up ci] [up ci, up ci] [([], .cross ci ci, []), ([], .dot ci, [up ci]), ([], .dot ci, [up ci])] =
      cl D Sc μ [up ci, up ci] [up ci, up ci] [([], .dot ci, [up ci])] - cl D Sc μ [up ci, up ci] [up ci, up ci] [([up ci], .dot ci, []), ([], .cross ci ci, []), ([], .dot ci, [up ci])] := by
    rw [cl_stepL_at _ 0 [] [] (E0 _) (by (try cnorm); cchain) (by (try cnorm); cchain) (by cnorm)]
    try simp only [map_add, map_sub, map_neg, map_zsmul, map_zero]
    repeat rw [ctxL_cl _ (by (try cnorm); cchain) (by (try cnorm); cchain)]
    try cnorm
    try cpar
    try simp only [hp_ci]
    try csign
    try abel
  -- step 2: dot-slide-right-same at layer 2, strands 1–2
  have K1 : cl D Sc μ [up ci, up ci] [up ci, up ci] [([up ci], .dot ci, []), ([], .cross ci ci, []), ([], .dot ci, [up ci])] =
      cl D Sc μ [up ci, up ci] [up ci, up ci] [([up ci], .dot ci, [])] - cl D Sc μ [up ci, up ci] [up ci, up ci] [([up ci], .dot ci, []), ([up ci], .dot ci, []), ([], .cross ci ci, [])] := by
    rw [cl_stepL_at _ 1 [] [] (E0 _) (by (try cnorm); cchain) (by (try cnorm); cchain) (by cnorm)]
    try simp only [map_add, map_sub, map_neg, map_zsmul, map_zero]
    repeat rw [ctxL_cl _ (by (try cnorm); cchain) (by (try cnorm); cchain)]
    try cnorm
    try cpar
    try simp only [hp_ci]
    try csign
