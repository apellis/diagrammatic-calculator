/-- A rotated crossing next to a cap, in type A2. Found by the calculator: a rewrite chain of 1 steps. -/
theorem cyclic_crossing_beside {I : Type u} {C : CartanDatum I} {X Y : Type v} [AddCommGroup X]
    [AddCommGroup Y] (RD : WeightDatum C X Y) (k : Type w) [CommRing k] (μ : X)
    (ci cj : I)
    (h_ci_cj : ci ≠ cj) :
    dg RD k μ [up ci, dn ci, dn cj] [up ci, dn cj, dn ci] [([up ci, dn ci, dn cj], .cup (up ci), []), ([up ci, dn ci, dn cj, up ci], .cup (up cj), [dn ci]), ([up ci, dn ci, dn cj], .cross true ci cj, [dn cj, dn ci]), ([up ci, dn ci], .cap (up cj), [up ci, dn cj, dn ci]), ([up ci], .cap (up ci), [dn cj, dn ci])] =
      dg RD k μ [up ci, dn ci, dn cj] [up ci, dn cj, dn ci] [([up ci], .cross false ci cj, [])] := by
  -- cyclic-crossing-right (left to right), a = i, b = j
  have E0 : ∀ ν : X, dg RD k ν [dn ci, dn cj] [dn cj, dn ci] [([dn ci, dn cj], .cup (up ci), []), ([dn ci, dn cj, up ci], .cup (up cj), [dn ci]), ([dn ci, dn cj], .cross true ci cj, [dn cj, dn ci]), ([dn ci], .cap (up cj), [up ci, dn cj, dn ci]), ([], .cap (up ci), [dn cj, dn ci])] =
      dg RD k ν [dn ci, dn cj] [dn cj, dn ci] [([], .cross false ci cj, [])] := fun ν => by
    exact (dg_cycCrossR RD k ci cj ν).symm
  -- step 1: cyclic-crossing-right at layer 1, strands 2–3
  have K0 : dg RD k μ [up ci, dn ci, dn cj] [up ci, dn cj, dn ci] [([up ci, dn ci, dn cj], .cup (up ci), []), ([up ci, dn ci, dn cj, up ci], .cup (up cj), [dn ci]), ([up ci, dn ci, dn cj], .cross true ci cj, [dn cj, dn ci]), ([up ci, dn ci], .cap (up cj), [up ci, dn cj, dn ci]), ([up ci], .cap (up ci), [dn cj, dn ci])] =
      dg RD k μ [up ci, dn ci, dn cj] [up ci, dn cj, dn ci] [([up ci], .cross false ci cj, [])] := by
    rw [dg_stepL_at _ 0 [up ci] [] (E0 _) (by (try dnorm); schain) (by (try dnorm); schain) (by dnorm)]
    try simp only [map_add, map_sub, map_neg, map_zsmul, map_zero]
    repeat rw [ctxL_dg RD k _ (by (try dnorm); schain) (by (try dnorm); schain)]
    try dnorm
    try abel
  rw [K0]
  try abel

