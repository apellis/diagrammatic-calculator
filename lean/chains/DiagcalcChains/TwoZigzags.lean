/-- Two zigzags in a row reduce to the identity. Found by the calculator: a rewrite chain of 2 steps. -/
theorem two_zigzags {I : Type u} {C : CartanDatum I} {X Y : Type v} [AddCommGroup X]
    [AddCommGroup Y] (RD : WeightDatum C X Y) (k : Type w) [CommRing k] (μ : X)
    (ci : I) :
    dg RD k μ [up ci] [up ci] [([], .cup (up ci), [up ci]), ([], .cup (up ci), [up ci, dn ci, up ci]), ([up ci, dn ci, up ci], .cap (up ci), []), ([up ci], .cap (up ci), [])] =
      dg RD k μ [up ci] [up ci] [] := by
  -- zigzag-up-left (left to right), a = i
  have E0 : ∀ ν : X, dg RD k ν [up ci] [up ci] [([], .cup (up ci), [up ci]), ([up ci], .cap (up ci), [])] =
      dg RD k ν [up ci] [up ci] [] := fun ν => by
    exact dg_zigL' RD k ν (up ci)
  -- step 1: zigzag-up-left at layer 1, strand 1
  have KL0 : dg RD k μ [up ci] [up ci] [([], .cup (up ci), [up ci]), ([], .cup (up ci), [up ci, dn ci, up ci]), ([up ci, dn ci, up ci], .cap (up ci), []), ([up ci], .cap (up ci), [])] =
      dg RD k μ [up ci] [up ci] [([], .cup (up ci), [up ci]), ([up ci], .cap (up ci), [])] := by
    dswap 1
    rw [dg_stepL_at _ 0 [] [] (E0 _) (by (try dnorm); schain) (by (try dnorm); schain) (by dnorm)]
    try simp only [map_add, map_sub, map_neg, map_zsmul, map_zero]
    repeat rw [ctxL_dg RD k _ (by (try dnorm); schain) (by (try dnorm); schain)]
    try dnorm
    try abel
  -- step 2: zigzag-up-left at layer 1, strand 1
  have KL1 : dg RD k μ [up ci] [up ci] [([], .cup (up ci), [up ci]), ([up ci], .cap (up ci), [])] =
      dg RD k μ [up ci] [up ci] [] := by
    rw [dg_stepL_at _ 0 [] [] (E0 _) (by (try dnorm); schain) (by (try dnorm); schain) (by dnorm)]
    try simp only [map_add, map_sub, map_neg, map_zsmul, map_zero]
    repeat rw [ctxL_dg RD k _ (by (try dnorm); schain) (by (try dnorm); schain)]
    try dnorm
    try abel
  have L : dg RD k μ [up ci] [up ci] [([], .cup (up ci), [up ci]), ([], .cup (up ci), [up ci, dn ci, up ci]), ([up ci, dn ci, up ci], .cap (up ci), []), ([up ci], .cap (up ci), [])] = dg RD k μ [up ci] [up ci] [] := by
    rw [KL0, KL1]
    try abel
  have R : dg RD k μ [up ci] [up ci] [] = dg RD k μ [up ci] [up ci] [] := by
    try abel
  exact L.trans R.symm

