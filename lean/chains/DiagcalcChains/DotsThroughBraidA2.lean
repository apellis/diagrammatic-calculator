      dg RD k μ [up ci, up cj, up ci] [up ci, up cj, up ci] [([], .dot (up ci), [up cj, up ci])] + dg RD k μ [up ci, up cj, up ci] [up ci, up cj, up ci] [([up ci], .dot (up cj), [up ci])] + dg RD k μ [up ci, up cj, up ci] [up ci, up cj, up ci] [([], .cross true ci cj, [up ci]), ([up cj, up ci], .dot (up ci), []), ([up cj], .cross true ci ci, []), ([], .cross true cj ci, [up ci])] := by
  -- dot-slide-left-distinct (left to right), a = j, b = i
  have E0 : ∀ ν : X, dg RD k ν [up cj, up ci] [up ci, up cj] [([], .cross true cj ci, []), ([], .dot (up ci), [up cj])] =
      dg RD k ν [up cj, up ci] [up ci, up cj] [([up cj], .dot (up ci), []), ([], .cross true cj ci, [])] := fun ν => by
    rw [dg_slideLNe RD k ν cj ci (h_ci_cj).symm]
    try abel
  -- dot-slide-left-same (left to right), a = i
  have E1 : ∀ ν : X, dg RD k ν [up ci, up ci] [up ci, up ci] [([], .cross true ci ci, []), ([], .dot (up ci), [up ci])] =
      dg RD k ν [up ci, up ci] [up ci, up ci] [] + dg RD k ν [up ci, up ci] [up ci, up ci] [([up ci], .dot (up ci), []), ([], .cross true ci ci, [])] := fun ν => by
    rw [dg_slideLEq RD k ν ci]
    try abel
  -- square-distinct (left to right), a = i, b = j
  have E2 : ∀ ν : X, dg RD k ν [up ci, up cj] [up ci, up cj] [([], .cross true ci cj, []), ([], .cross true cj ci, [])] =
      dg RD k ν [up ci, up cj] [up ci, up cj] [([], .dot (up ci), [up cj])] + dg RD k ν [up ci, up cj] [up ci, up cj] [([up ci], .dot (up cj), [])] := fun ν => by
    rw [dg_sqNe RD k ν ci cj h_ci_cj]
    try simp only [hdot_ci_cj, hdij_ci_cj, hdij_cj_ci, ↓reduceIte, Finset.sum_range_succ, Finset.sum_range_zero, zero_add, Nat.reduceSub, Nat.reduceAdd, Nat.sub_zero, List.replicate_succ, List.replicate_zero, List.cons_append, List.nil_append, List.append_nil]
    try abel
  -- step 1: dot-slide-left-distinct at layer 3, strands 1–2
  have K0 : dg RD k μ [up ci, up cj, up ci] [up ci, up cj, up ci] [([], .cross true ci cj, [up ci]), ([up cj], .cross true ci ci, []), ([], .cross true cj ci, [up ci]), ([], .dot (up ci), [up cj, up ci])] =
      dg RD k μ [up ci, up cj, up ci] [up ci, up cj, up ci] [([], .cross true ci cj, [up ci]), ([up cj], .cross true ci ci, []), ([up cj], .dot (up ci), [up ci]), ([], .cross true cj ci, [up ci])] := by
    rw [dg_stepL_at _ 2 [] [up ci] (E0 _) (by (try dnorm); schain) (by (try dnorm); schain) (by dnorm)]
    try simp only [map_add, map_sub, map_neg, map_zsmul, map_zero]
    repeat rw [ctxL_dg RD k _ (by (try dnorm); schain) (by (try dnorm); schain)]
    try dnorm
    try abel
  -- step 2: dot-slide-left-same at layer 2, strands 2–3
  have K1 : dg RD k μ [up ci, up cj, up ci] [up ci, up cj, up ci] [([], .cross true ci cj, [up ci]), ([up cj], .cross true ci ci, []), ([up cj], .dot (up ci), [up ci]), ([], .cross true cj ci, [up ci])] =
      dg RD k μ [up ci, up cj, up ci] [up ci, up cj, up ci] [([], .cross true ci cj, [up ci]), ([], .cross true cj ci, [up ci])] + dg RD k μ [up ci, up cj, up ci] [up ci, up cj, up ci] [([], .cross true ci cj, [up ci]), ([up cj, up ci], .dot (up ci), []), ([up cj], .cross true ci ci, []), ([], .cross true cj ci, [up ci])] := by
    rw [dg_stepL_at _ 1 [up cj] [] (E1 _) (by (try dnorm); schain) (by (try dnorm); schain) (by dnorm)]
