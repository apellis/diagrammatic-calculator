      dg RD k μ [up ci, up cj, up ci] [up ci, up cj, up ci] [([], .dot (up ci), [up cj, up ci])] + dg RD k μ [up ci, up cj, up ci] [up ci, up cj, up ci] [([up ci], .dot (up cj), [up ci])] := by
    rw [dg_stepL_at _ 0 [] [up ci] (E2 _) (by (try dnorm); schain) (by (try dnorm); schain) (by dnorm)]
    try simp only [map_add, map_sub, map_neg, map_zsmul, map_zero]
    repeat rw [ctxL_dg RD k _ (by (try dnorm); schain) (by (try dnorm); schain)]
