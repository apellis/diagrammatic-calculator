# Response headers of every static file on Cloudflare Pages (vite.config.ts serves the same ones
# in `vite preview`, so the browser tests run under them). Pages Functions (/api/) set their own.
#
# Cross-origin isolation, for multi-core WebAssembly. The Content-Security-Policy allows scripts,
# workers, styles, fonts and images from this site only (plus WebAssembly compilation, and inline
# style attributes, which KaTeX and the canvas use); network requests to this site and to the AI
# providers: Anthropic, OpenAI, and an OpenAI-compatible server the person names, which can be
# any https address or a server on this computer. Nothing may frame the app, and no page it links
# to learns where the visitor came from.
/*
  Cross-Origin-Opener-Policy: same-origin
  Cross-Origin-Embedder-Policy: require-corp
  Content-Security-Policy: default-src 'self'; script-src 'self' 'wasm-unsafe-eval'; worker-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self' data:; connect-src 'self' https://api.anthropic.com https://api.openai.com https: http://localhost:* http://127.0.0.1:*; object-src 'none'; base-uri 'none'; form-action 'self'; frame-ancestors 'none'
  Referrer-Policy: no-referrer
  X-Content-Type-Options: nosniff
